# cssparser/meson.build

# List all source files (headers are optional, but useful for IDEs)
cssparser_sources = files(
    'css_denest.cpp',
    'css_parser.cpp',
    'css_properties.cpp',
    'css_utils.cpp'
)

# Specify where the library's header files are located
cssparser_inc = include_directories('.')

# Create the library itself (static or shared, depending on Meson settings)
cssparser_lib = library(
    'cssparser',
    cssparser_sources,
    include_directories: cssparser_inc,
    install: false # Set to true if it should be installed system-wide
)

# Create a dependency that can be easily linked into your main executable
cssparser_dep = declare_dependency(
    link_with: cssparser_lib,
    # include_directories: cssparser_inc
)
