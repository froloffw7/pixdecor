pixdecor = shared_module('pixdecor',
        ['pixdecor.cpp', 'deco-theme.cpp', 'deco-layout.cpp',
         'deco-cairo.cpp', 'deco-surface.cpp', 'deco-shader.cpp',
         'deco-settings.cpp', 'deco-gtk-theme.cpp', 'gtk_settings.cpp',
         'deco-theme-update.cpp' ],
        dependencies: [wayfire],
        install: true,
        install_dir: join_paths(get_option('libdir'), 'wayfire'))
